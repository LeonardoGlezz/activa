# Copia este archivo como .env (npm run setup lo hace por ti la primera vez).
# Valores pensados para desarrollo local con docker-compose.yml de la raíz.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=activa
DB_USER=root
DB_PASS=activa

# Cambia esto por una cadena larga y aleatoria. Nunca subas tu .env al repo.
JWT_SECRET=cambia-esto-por-una-clave-larga

PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Opcionales: solo si vas a probar pagos con Stripe o login con Google.
# Stripe exige una clave para arrancar; este valor de relleno basta para usar todo menos los pagos.
STRIPE_SECRET_KEY=sk_test_sin_configurar
STRIPE_PRICE_BASICO=
STRIPE_PRICE_ILIMITADO=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
