# Copia este archivo como .env (npm run setup lo hace por ti la primera vez
# y genera JWT_SECRET automáticamente). Nunca subas tu .env al repo.
# Valores pensados para desarrollo local con docker-compose.yml de la raíz.

PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=activa
DB_USER=root
DB_PASS=activa
# En la nube (TiDB Cloud, Aiven) pon DB_SSL=true
DB_SSL=false

# Obligatoria, mínimo 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

FRONTEND_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000

# Opcional: guarda los archivos subidos en un bucket S3/Cloudflare R2 en vez del disco
# (necesario en hostings gratis, que borran el disco). Vacío = disco local.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# O guárdalos en la propia base (tabla stored_file, máximo 5 MB por archivo):
UPLOADS_IN_DB=false

# Solo producción: crea esta cuenta de administrador al arrancar si no existe.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Si olvidas la contraseña del admin: pon una nueva en ADMIN_PASSWORD y
# ADMIN_RESET_PASSWORD=true; al reiniciar se aplica. Después quítala.
# ADMIN_RESET_PASSWORD=

# Opcionales: solo si vas a probar pagos con Stripe o login con Google.
GOOGLE_CLIENT_ID=
# Sin una clave real de Stripe no se cobra: los fisios aprobados usan todo sin plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_ILIMITADO=
APPOINTMENT_REVENUE_MXN=

# Zona horaria para recordatorios de citas y fechas de las sesiones
APP_TIMEZONE=America/Mexico_City

# Correo para recordatorios de cita (opcional; sin SMTP_HOST no se mandan correos)
# Brevo gratis: smtp-relay.brevo.com:587 · Gmail: smtp.gmail.com:587 con contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
